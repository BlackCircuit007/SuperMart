# ==================== Backend (Node.js/Express) ====================
PORT=3000

# ==================== Database ====================
# CockroachDB (PostgreSQL-compatible) connection
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=verify-full

# ==================== Email (Brevo HTTP API) ====================
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=YourStoreName
OWNER_EMAIL=owner@example.com

# ==================== JWT Secret ====================
JWT_SECRET=your-jwt-secret-key-here

# ==================== Base URL ====================
# Uncomment and set for production (must point to your public deployed URL)
# BASE_URL=https://your-deployed-url.example

# ==================== Environment ====================
NODE_ENV=development

# ==================== Bank transfer instructions ====================
# Leave unset to disable bank transfer checkout until real account details exist.
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=

# ==================== Flutterwave (online card/transfer payments) ====================
# Test-mode keys from https://dashboard.flutterwave.com → Settings → API Keys
# Get these from: https://dashboard.flutterwave.com/settings/api-keys
FLW_PUBLIC_KEY=FLWPUBK_TEST-your-public-key-here
FLW_SECRET_KEY=FLWSECK_TEST-your-secret-key-here
# Webhook signature — Settings → Webhooks → "Secret hash". Sent as 'verif-hash'.
# Configure your webhook URL: https://your-domain.com/api/webhooks/flutterwave
# Enable events: "charge.completed", "charge.noconf", "charge.failed"
FLW_WEBHOOK_SECRET_HASH=your-webhook-secret-hash-here

# ==================== POS Integration ====================
# External POS systems authenticate with: header x-pos-api-key: <key>
# Format: "key:supermarket-slug" entries, comma separated.
# POS_API_KEYS=key1:default,key2:store-b