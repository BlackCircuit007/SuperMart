EMAILJS_TEMPLATE_ID=template_ddax5bh
EMAILJS_LOGIN_TEMPLATE_ID=template_ddax5bh
EMAILJS_PUBLIC_KEY=1JESagoXdGOO8s-EK

# ==================== Legacy SMTP (fallback only) ====================
# The Node.js backend can use these as a fallback if EmailJS fails.
# Not required if EmailJS is configured.
